# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional: channel to post alerts in if a DM fails (right-click channel -> Copy Channel ID)
DISCORD_ALERT_CHANNEL_ID=

# Where the SQLite database lives
DB_PATH=data/adoptme.db

# How often to poll the value sites (minutes). Be gentle; 30+ is sensible.
POLL_MINUTES=30

# Politeness: minimum seconds between requests to the same host
MIN_DELAY_SECONDS=5
# Respect each site's robots.txt (leave true unless the site owner says otherwise)
RESPECT_ROBOTS=true
# Identify yourself so site owners can reach you
USER_AGENT=adoptme-tracker/0.1 (personal use; contact: you@example.com)

# Source config (selectors, page URLs)
SOURCES_CONFIG=config/sources.json
